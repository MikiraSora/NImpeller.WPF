<Window x:Class="HelloWPFImpellerGallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:imp="clr-namespace:NImpeller.Wpf;assembly=NImpeller.Wpf"
        xmlns:scenes="clr-namespace:HelloWPFImpellerGallery.Scenes"
        Title="HelloWPFImpellerGallery"
        Width="1280" Height="800"
        Background="#1A1D22">
    <Window.Resources>
        <!-- Scene list item template: bold name + dim description -->
        <DataTemplate x:Key="SceneItemTemplate" DataType="{x:Type scenes:IGalleryScene}">
            <StackPanel Margin="6,4">
                <TextBlock Text="{Binding Name}"
                           FontSize="14" Foreground="#E8E8E8" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Description}"
                           FontSize="11" Foreground="#909090"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: gallery list -->
        <Border Grid.Column="0" Background="#232830" BorderBrush="#373E48" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Impeller Gallery"
                           Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"
                           Margin="14,12,14,10"/>
                <ListBox x:Name="SceneList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#E8E8E8"
                         ItemTemplate="{StaticResource SceneItemTemplate}"
                         SelectionChanged="SceneList_OnSelectionChanged"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3A5A8C"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2E3741"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- RIGHT: Impeller render surface -->
        <imp:ImpellerView x:Name="GalleryView" Grid.Column="1"
                          Render="GalleryView_OnRender"/>
    </Grid>
</Window>
